---
import "@fontsource-variable/playfair-display";
import "@fontsource-variable/manrope";
import "../styles/global.css";
import { t } from "../i18n/uk";
import { BUSINESS } from "../config";

interface Props {
  title: string;
  description: string;
  /** Додаткові JSON-LD блоки сторінки (вже згенеровані з контракту). */
  jsonLd?: Record<string, unknown>[];
  ogImage?: string;
}

const { title, description, jsonLd = [], ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* hreflang-структура: UA зараз, EN/RU додаються тут же (PHASE1_BRIEF §5) */}
    <link rel="alternate" hreflang="uk" href={canonical.href} />
    <link rel="alternate" hreflang="x-default" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site).href} />}
    {jsonLd.map((block) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body class="min-h-screen bg-ivory text-body flex flex-col">
    <header class="bg-ink text-ivory">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 flex items-center justify-between h-16">
        <a href="/" class="caps-label text-ivory text-sm tracking-[0.3em]">{t.site.name}</a>
        <nav aria-label="Основна навігація">
          <a href="/" class="caps-label text-ivory/80 hover:text-brass transition-colors">{t.nav.catalog}</a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-ink text-ivory/70 mt-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 flex flex-col sm:flex-row gap-4 items-start sm:items-center justify-between">
        <div>
          <p class="caps-label text-ivory">{t.site.name} · {BUSINESS.tagline}</p>
          <p class="mt-2 text-sm">{t.footer.address}</p>
        </div>
        <p class="text-sm">
          <a href={`mailto:${BUSINESS.email}`} class="hover:text-brass transition-colors">{BUSINESS.email}</a>
          <span class="mx-2">·</span>
          <a href={`tel:${BUSINESS.phone.replace(/[^+\d]/g, "")}`} class="hover:text-brass transition-colors">{BUSINESS.phone}</a>
        </p>
      </div>
    </footer>
  </body>
</html>
