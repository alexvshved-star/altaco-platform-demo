---
// Одне зображення матеріалу за індексом. Реальне фото (PHOTO_GUIDE.md) або,
// якщо файлів немає, генерований патерн-плейсхолдер у DOM (Р-07).
import { placeholderSvg } from "../lib/placeholder";
import { imageAlt } from "../lib/catalog";
import type { Material } from "../lib/types";

interface Props {
  material: Material;
  /** Індекс фото (0 = перше; сітка завжди 0). */
  index?: number;
  class?: string;
  loading?: "lazy" | "eager";
}

const { material: m, index = 0, class: cls = "", loading = "lazy" } = Astro.props;
const src = m.photos[index] ?? null;
const alt = imageAlt(m);
---

{src ? (
  <img src={src} alt={alt} class={cls} loading={loading} decoding="async" />
) : (
  <div class={cls} set:html={placeholderSvg(m.id, m.name)} />
)}
