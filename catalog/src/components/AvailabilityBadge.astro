---
// Узагальнений бейдж наявності (PHASE1_BRIEF §2): без точних кількостей.
import { t } from "../i18n/uk";
import type { Material } from "../lib/types";

interface Props {
  material: Material;
  class?: string;
}

const { material: m, class: cls = "" } = Astro.props;
const label =
  m.stockLocation === "kyiv"
    ? t.card.inStockKyiv
    : m.stockLocation === "dnipro"
      ? t.card.inStockDnipro
      : t.card.preOrder;
// Наявність — акцентний (темний) бейдж; «Під замовлення» — приглушений.
const tone = m.stockLocation === "on_order" ? "bg-muted text-ivory" : "bg-ink text-ivory";
---

<span class={`caps-label inline-block ${tone} px-3 py-1.5 ${cls}`}>{label}</span>
