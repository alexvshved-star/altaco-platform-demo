---
// Каталог (макет стор. 8): фільтр-бар, лічильник, сортування за ціною, сітка карток.
// Увесь контент у DOM на етапі SSG; фільтри — прогресивне підсилення без фреймворку.
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import MaterialCard from "../components/MaterialCard.astro";
import { getMaterials, getFacets } from "../lib/catalog";
import {
  localBusinessJsonLd,
  organizationJsonLd,
  webSiteJsonLd,
  collectionPageJsonLd,
} from "../lib/jsonld";
import { t, pluralMaterials } from "../i18n/uk";

const materials = getMaterials();
const facets = getFacets(materials);
const siteUrl = Astro.site!.href;

const title = `${t.catalog.title} | ${t.site.name} — камінь у Києві`;
const description = t.site.description;

// Головна = каталог: Organization + WebSite + LocalBusiness + CollectionPage (зі списком позицій).
const jsonLd = [
  organizationJsonLd(siteUrl),
  webSiteJsonLd(siteUrl),
  localBusinessJsonLd(siteUrl),
  collectionPageJsonLd(
    siteUrl,
    materials.map((m) => ({ name: m.name, url: m.url })),
    title,
    description,
  ),
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <Hero />
  <section id="catalog" class="scroll-mt-4 mx-auto max-w-7xl px-4 sm:px-6">
    <div class="border-b border-hairline py-4" data-role="filterbar">
      <span class="caps-label text-muted">{t.catalog.filters}</span>
      {/* Патерн «лейбл над селектом»: 1 кол. (моб) → 2×2 (sm) → 4 в ряд (lg). Селекти w-full, рівна висота. */}
      <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-5 gap-y-4">
        {facets.map((f) => (
          <label class="flex flex-col gap-1.5">
            <span class="caps-label text-muted">{f.label}</span>
            <select
              class="w-full border border-hairline bg-paper px-2 py-1.5 text-sm"
              data-facet={f.key}
              aria-label={f.label}
            >
              <option value="">—</option>
              {f.values.map((v) => (
                <option value={v.value}>{v.label} ({v.count})</option>
              ))}
            </select>
          </label>
        ))}
      </div>
      <div class="mt-3 flex justify-end">
        <button
          type="button"
          class="caps-label text-brass-text hover:text-brass-deep transition-colors cursor-pointer"
          data-role="reset"
        >{t.catalog.reset}</button>
      </div>
    </div>

    <div class="py-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="font-serif text-4xl">{t.catalog.title}</h1>
        <p class="mt-2 max-w-xl text-muted text-sm">{t.catalog.intro}</p>
      </div>
      <div class="flex items-end justify-between gap-6 w-full sm:w-auto">
        <label class="flex flex-col gap-1.5">
          <span class="caps-label text-muted">{t.catalog.sort}</span>
          <select class="border border-hairline bg-paper px-2 py-1.5 text-sm" data-role="sort" aria-label={t.catalog.sort}>
            <option value="">—</option>
            <option value="price-asc">{t.catalog.sortPriceAsc}</option>
            <option value="price-desc">{t.catalog.sortPriceDesc}</option>
            <option value="name">{t.catalog.sortName}</option>
          </select>
        </label>
        <p class="caps-label text-muted whitespace-nowrap" data-role="count" data-total={materials.length}>
          {materials.length} {pluralMaterials(materials.length)}
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-role="grid">
      {materials.map((m) => <MaterialCard material={m} />)}
    </div>
    <p class="hidden py-16 text-center text-muted" data-role="empty">{t.catalog.empty}</p>
  </section>
</Base>

<script>
  // Фільтри: значення лише з data-атрибутів, згенерованих із контракту.
  // Комбінація фасетів = перетин; «скинути» повертає все (PHASE1_BRIEF §6).
  const grid = document.querySelector<HTMLElement>('[data-role="grid"]')!;
  const cards = [...grid.querySelectorAll<HTMLElement>(".material-card")];
  const selects = [...document.querySelectorAll<HTMLSelectElement>("[data-facet]")];
  const sortSel = document.querySelector<HTMLSelectElement>('[data-role="sort"]')!;
  const counter = document.querySelector<HTMLElement>('[data-role="count"]')!;
  const empty = document.querySelector<HTMLElement>('[data-role="empty"]')!;
  const reset = document.querySelector<HTMLButtonElement>('[data-role="reset"]')!;

  // Українська плюралізація — дзеркало pluralMaterials із src/i18n/uk.ts.
  function plural(n: number): string {
    const m10 = n % 10, m100 = n % 100;
    if (m10 === 1 && m100 !== 11) return "матеріал";
    if (m10 >= 2 && m10 <= 4 && (m100 < 10 || m100 >= 20)) return "матеріали";
    return "матеріалів";
  }

  function matches(card: HTMLElement): boolean {
    return selects.every((sel) => {
      if (!sel.value) return true;
      const raw = card.dataset[sel.dataset.facet!] ?? "";
      return raw.split(" ").includes(sel.value);
    });
  }

  function apply(): void {
    let visible = 0;
    for (const card of cards) {
      const ok = matches(card);
      card.style.display = ok ? "" : "none";
      if (ok) visible++;
    }
    counter.textContent = `${visible} ${plural(visible)}`;
    empty.classList.toggle("hidden", visible > 0);
    grid.classList.toggle("hidden", visible === 0);
  }

  function sortCards(): void {
    const mode = sortSel.value;
    if (!mode) return;
    const sorted = [...cards].sort((a, b) => {
      if (mode === "name") return (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "", "uk");
      const pa = a.dataset.price === "" ? Infinity : Number(a.dataset.price);
      const pb = b.dataset.price === "" ? Infinity : Number(b.dataset.price);
      return mode === "price-desc" && pa !== Infinity && pb !== Infinity ? pb - pa : pa - pb;
    });
    for (const el of sorted) grid.appendChild(el);
  }

  for (const sel of selects) sel.addEventListener("change", apply);
  sortSel.addEventListener("change", sortCards);
  reset.addEventListener("click", () => {
    for (const sel of selects) sel.value = "";
    sortSel.value = "";
    apply();
  });
</script>
