---
// Картка матеріалу (макет стор. 9): фото зліва, специфікація справа.
// getStaticPaths генерує сторінки лише для видимих позицій:
// hidden/не-published у production не існують — 404 (PHASE1_BRIEF §6).
import Base from "../../layouts/Base.astro";
import MaterialImage from "../../components/MaterialImage.astro";
import AvailabilityBadge from "../../components/AvailabilityBadge.astro";
import { getMaterials, typeLabel, finishLabel, imageAlt } from "../../lib/catalog";
import { formatPriceM2, slabPricing } from "../../lib/format";
import { productJsonLd, breadcrumbJsonLd } from "../../lib/jsonld";
import { t } from "../../i18n/uk";
import { BUSINESS } from "../../config";
import { withBase } from "../../lib/base";

export function getStaticPaths() {
  return getMaterials().map((m) => ({ params: { id: m.id }, props: { material: m } }));
}

// Тип props виводиться з getStaticPaths.
const { material: m } = Astro.props;
const siteUrl = Astro.site!.href;

// SEO-метадані генеруються з полів матеріалу (5b): тип, колекція, обробка, товщина,
// місто наявності, ціна. Місто — зі stock_location; in-stock і під замовлення мають
// різні шаблони, наскрізно — можливість поставки під замовлення по Україні.
const typeL = typeLabel(m.type);
const collection = m.lineName;
const inStock = m.stockLocation !== "on_order";
const cityLoc = m.stockLocation === "dnipro" ? "Дніпрі" : "Києві";
const finishText = m.finishes.length ? m.finishes.map(finishLabel).join(", ") : "—";
const thicknessText = m.thicknesses_mm.length ? `${m.thicknesses_mm.join(", ")} мм` : "—";
const availText = inStock ? `В наявності у ${cityLoc}` : "Під замовлення";
const priceText = m.priceFromEurM2 ? formatPriceM2(m.priceFromEurM2) : "за запитом";
const title = inStock
  ? `${m.name} — ${typeL}, ${collection} | сляб у ${cityLoc} та під замовлення | ${t.site.name}`
  : `${m.name} — ${typeL}, ${collection} | під замовлення в Україні | ${t.site.name}`;
const description =
  `${m.name} — ${typeL}, колекція ${collection}, обробка ${finishText}, товщина ${thicknessText}. ` +
  `${availText}. Поставка під замовлення по Україні. Ціна ${priceText}. ${t.site.name}, ${BUSINESS.city}.`;

const price = formatPriceM2(m.priceFromEurM2);
const jsonLd = [productJsonLd(m, siteUrl), breadcrumbJsonLd(m, siteUrl)];

// Ціна за цілий сляб — розрахунок на етапі build (площа без округлення; ціна → до 10 €).
const { areaDisplay, slabPriceDisplay } = slabPricing(m.slabSize, m.priceFromEurM2);

// Порожнє поле → рядок специфікації не рендериться (CLAUDE.md №6).
// Порядок: Тип · Лінія · Фініш · Формат · Товщина · Площа.
const specs: Array<[string, string]> = [
  [t.card.specType, typeLabel(m.type)],
  [t.card.specLine, m.lineName],
  ...(m.origin ? [[t.card.specOrigin, m.origin] as [string, string]] : []),
  ...(m.color ? [[t.card.specColor, m.color] as [string, string]] : []),
  ...(m.finishes.length
    ? [[m.finishes.length > 1 ? t.card.specFinishes : t.card.specFinish, m.finishes.map(finishLabel).join(", ")] as [string, string]]
    : []),
  ...(m.slabSize ? [[t.card.specFormat, `${m.slabSize.h} × ${m.slabSize.w} мм`] as [string, string]] : []),
  ...(m.thicknesses_mm.length ? [[t.card.thicknessOne, `${m.thicknesses_mm.join(", ")} мм`] as [string, string]] : []),
  ...(areaDisplay ? [[t.card.specArea, areaDisplay] as [string, string]] : []),
];

// Повний URL сторінки (для mailto body та тексту в Telegram).
const pageUrl = new URL(m.url, siteUrl).href;
const mailSubject = encodeURIComponent(`КП: ${m.name} (${m.id})`);
const mailBody = encodeURIComponent(`Матеріал: ${m.name}\nСторінка: ${pageUrl}`);
const quoteHref = `mailto:${BUSINESS.email}?subject=${mailSubject}&body=${mailBody}`;
const requestHref = `${BUSINESS.telegram}?text=${encodeURIComponent(`${m.name}\n${pageUrl}`)}`;
const ogImage = m.photos[0] ?? undefined;

// Дані для клієнтської генерації КП у PDF (pdfmake). Площа сляба — дефолт поля вводу.
const slabAreaDefault = m.slabSize
  ? Number(((m.slabSize.h * m.slabSize.w) / 1_000_000).toFixed(2))
  : null;
const kpData = {
  id: m.id,
  name: m.name,
  type: typeLabel(m.type),
  line: m.lineName,
  finish: m.finishes.map(finishLabel).join(", "),
  format: m.slabSize ? `${m.slabSize.h} × ${m.slabSize.w} мм` : "",
  thickness: m.thicknesses_mm.length ? `${m.thicknesses_mm.join(", ")} мм` : "",
  areaDefault: slabAreaDefault,
  pricePerM2: m.priceFromEurM2,
  photo: m.photos[0] ?? null,
  pageUrl,
  business: {
    director: "Олександр Швед, Директор · ALTACO",
    legal: t.footer.legal,
    phone: BUSINESS.phone,
    email: BUSINESS.email,
    site: t.footer.site,
    overline: t.hero.overline,
    priceNote: t.card.priceNote,
  },
};
---

<Base title={title} description={description} jsonLd={jsonLd} ogImage={ogImage} ogType="product">
  <div class="mx-auto max-w-7xl lg:grid lg:grid-cols-[55%_45%] lg:items-start">
    <div class="lg:sticky lg:top-0">
      {/* Галерея: hero = фото 1; мініатюри перемикають hero (PHASE1_BRIEF §1: «у картці всі три»). */}
      <div class="relative" data-gallery>
        {/* Фіксований aspect-ratio контейнера → нуль CLS; object-contain показує сляб повністю. */}
        <div class="aspect-[16/10] w-full overflow-hidden bg-paper">
          {m.photos.length > 0 ? (
            m.photos.map((src, i) => (
              <img
                src={src}
                alt={imageAlt(m)}
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
                data-hero={i}
                class:list={["h-full w-full object-cover", { hidden: i !== 0 }]}
              />
            ))
          ) : (
            <MaterialImage material={m} index={0} class="block h-full w-full [&>svg]:h-full [&>svg]:w-full" />
          )}
        </div>
        <AvailabilityBadge material={m} class="absolute left-4 top-4" />
      </div>

      {m.photos.length > 1 && (
        <div class="mt-2 grid grid-cols-4 gap-2 px-1" role="group" aria-label="Фото матеріалу">
          {m.photos.map((src, i) => (
            <button
              type="button"
              data-thumb={i}
              aria-label={`Показати фото ${i + 1}`}
              aria-pressed={i === 0 ? "true" : "false"}
              class="aspect-square overflow-hidden border border-hairline cursor-pointer aria-pressed:border-brass aria-pressed:ring-1 aria-pressed:ring-brass"
            >
              <img src={src} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="px-4 sm:px-8 py-8">
      <nav aria-label="Хлібні крихти" class="text-sm text-muted">
        <a href={withBase("/")} class="hover:text-brass transition-colors">{t.card.breadcrumbCatalog}</a>
        <span class="mx-1.5">/</span>
        <span aria-current="page">{m.name}</span>
      </nav>

      <p class="caps-label mt-6 text-brass-text">{m.lineName} · {typeLabel(m.type)}</p>
      <h1 class="font-serif text-4xl sm:text-5xl mt-2">{m.name}</h1>

      <h2 class="sr-only">{t.card.specs}</h2>
      <dl class="mt-8">
        {specs.map(([label, value]) => (
          <div class="flex items-baseline justify-between gap-6 border-b border-hairline py-3">
            <dt class="text-sm text-muted">{label}</dt>
            <dd class="text-sm text-right font-medium">{value}</dd>
          </div>
        ))}
      </dl>

      {m.applications.length > 0 && (
        <div class="mt-6">
          <p class="caps-label text-muted">{t.card.applications}</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {m.applications.map((a) => (
              <li class="border border-hairline px-3 py-1 text-sm">{a}</li>
            ))}
          </ul>
        </div>
      )}

      {/* Ціновий блок: лише €/м², €/сляб і примітка. Розміри — у таблиці характеристик. */}
      <div class="mt-10" data-role="pricing">
        <p class="font-serif text-3xl text-brass-deep" data-role="price">{price}</p>
        {slabPriceDisplay
          ? <p class="font-serif text-2xl text-brass-deep mt-3">{slabPriceDisplay}</p>
          : <p class="text-sm text-muted mt-3">{t.card.slabPriceUnknown}</p>}
        <p class="mt-3 text-xs text-muted">{t.card.priceNote}</p>
      </div>

      {/* CTA: моб — КП на повну ширину, нижче email+telegram 50/50; sm+ — три в ряд, КП ширша. */}
      <div class="mt-8 grid grid-cols-2 sm:grid-cols-[1.4fr_1fr_1fr] gap-3">
        <button
          type="button"
          data-role="kp-open"
          class="col-span-2 sm:col-span-1 caps-label text-center bg-brass text-ink px-6 py-3.5 hover:bg-brass-deep transition-colors cursor-pointer"
        >{t.card.formKp}</button>
        <a
          href={quoteHref}
          class="caps-label text-center border border-ink px-6 py-3.5 hover:border-brass hover:text-brass transition-colors"
        >{t.card.writeEmail}</a>
        <a
          href={requestHref}
          rel="noopener"
          class="caps-label text-center border border-ink px-6 py-3.5 hover:border-brass hover:text-brass transition-colors"
        >{t.card.writeTelegram}</a>
      </div>
    </div>
  </div>

  {/* Дані для клієнтського pdfmake (без рендера на сторінці). */}
  <script type="application/json" data-role="kp-data" set:html={JSON.stringify(kpData)} is:inline />

  {/* Модальне вікно вводу площі перед формуванням КП. */}
  <dialog
    data-role="kp-dialog"
    class="m-auto w-[min(92vw,28rem)] bg-paper text-body p-6 backdrop:bg-ink/50"
  >
    <form method="dialog" class="flex flex-col gap-4">
      <div>
        <h2 class="font-serif text-2xl">{t.card.kpTitle}</h2>
        <p class="mt-1 text-sm text-muted">{t.card.kpHint}</p>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <label class="flex flex-col gap-1.5">
          <span class="caps-label text-muted">{t.card.kpAreaLabel}</span>
          <input
            data-role="kp-area"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            class="w-full border border-hairline bg-paper px-3 py-2 text-base"
          />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="caps-label text-muted">{t.card.kpQtyLabel}</span>
          <input
            data-role="kp-qty"
            type="number"
            min="1"
            step="1"
            inputmode="numeric"
            autocomplete="off"
            class="w-full border border-hairline bg-paper px-3 py-2 text-base"
          />
        </label>
      </div>
      <p class="font-serif text-xl text-brass-deep" data-role="kp-sum" aria-live="polite"></p>
      <div class="flex justify-end gap-3">
        <button
          type="button"
          data-role="kp-cancel"
          class="caps-label border border-ink px-5 py-2.5 hover:border-brass hover:text-brass transition-colors cursor-pointer"
        >{t.card.kpCancel}</button>
        <button
          type="button"
          data-role="kp-generate"
          class="caps-label bg-brass text-ink px-5 py-2.5 hover:bg-brass-deep transition-colors cursor-pointer disabled:opacity-60"
        >{t.card.kpGenerate}</button>
      </div>
    </form>
  </dialog>

  {m.description && (
    <section class="mx-auto max-w-7xl px-4 sm:px-8 mt-12">
      <h2 class="font-serif text-2xl">{t.card.description}</h2>
      <p class="mt-3 max-w-prose text-body/90 leading-relaxed">{m.description}</p>
    </section>
  )}
</Base>

<script>
  // Перемикання hero-фото мініатюрами. Без JS усі фото лишаються в DOM (SSG),
  // hero = фото 1 — це і є дефолт для краулерів/агентів.
  const gallery = document.querySelector<HTMLElement>("[data-gallery]");
  if (gallery) {
    const heroes = [...gallery.querySelectorAll<HTMLElement>("[data-hero]")];
    const thumbs = [...document.querySelectorAll<HTMLButtonElement>("[data-thumb]")];
    for (const thumb of thumbs) {
      thumb.addEventListener("click", () => {
        const idx = Number(thumb.dataset.thumb);
        heroes.forEach((h, i) => h.classList.toggle("hidden", i !== idx));
        thumbs.forEach((t) => t.setAttribute("aria-pressed", t === thumb ? "true" : "false"));
      });
    }
  }
</script>

<script>
  // Генерація КП у PDF — повністю в браузері (pdfmake), без збереження на сервер.
  // pdfmake вантажиться динамічно (важкий бандл) лише при формуванні.
  interface KpData {
    id: string; name: string; type: string; line: string; finish: string;
    format: string; thickness: string; areaDefault: number | null;
    pricePerM2: number | null; photo: string | null; pageUrl: string;
    business: { director: string; legal: string; phone: string; email: string; site: string; overline: string; priceNote: string };
  }

  const dataEl = document.querySelector<HTMLScriptElement>('[data-role="kp-data"]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-role="kp-dialog"]');
  if (dataEl && dialog) {
    const data: KpData = JSON.parse(dataEl.textContent || "{}");
    const openBtn = document.querySelector<HTMLButtonElement>('[data-role="kp-open"]');
    const cancelBtn = document.querySelector<HTMLButtonElement>('[data-role="kp-cancel"]');
    const genBtn = document.querySelector<HTMLButtonElement>('[data-role="kp-generate"]');
    const areaInput = document.querySelector<HTMLInputElement>('[data-role="kp-area"]');
    const qtyInput = document.querySelector<HTMLInputElement>('[data-role="kp-qty"]');
    const sumEl = document.querySelector<HTMLElement>('[data-role="kp-sum"]');

    const parseArea = (v: string): number | null => {
      const n = parseFloat(v.replace(",", ".").trim());
      return Number.isFinite(n) && n > 0 ? n : null;
    };
    const parseQty = (v: string): number => {
      const n = parseInt(v.trim(), 10);
      return Number.isFinite(n) && n > 0 ? n : 1;
    };
    // КАНОНІЧНА формула (одна для картки, модалки, PDF): Площа × Кількість × Ціна/м²,
    // округлення до цілого євро на виводі. Збігається зі slabTotal() у format.ts.
    const total = (area: number, qty: number, price: number) => Math.round((area * qty * price) / 10) * 10;
    const eur = (n: number) => `€${n.toLocaleString("uk-UA")}`;
    const num2 = (n: number) => n.toLocaleString("uk-UA", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    function refreshSum(): void {
      const a = areaInput ? parseArea(areaInput.value) : null;
      const q = qtyInput ? parseQty(qtyInput.value) : 1;
      if (sumEl) sumEl.textContent = a && data.pricePerM2 ? `Разом: ${eur(total(a, q, data.pricePerM2))}` : "";
    }

    openBtn?.addEventListener("click", () => {
      if (areaInput) areaInput.value = data.areaDefault != null ? num2(data.areaDefault) : "";
      if (qtyInput) qtyInput.value = "1";
      refreshSum();
      dialog!.showModal();
    });
    cancelBtn?.addEventListener("click", () => dialog!.close());
    areaInput?.addEventListener("input", refreshSum);
    qtyInput?.addEventListener("input", refreshSum);

    // webp → JPEG dataURL через canvas (pdfmake/PDFKit не читає webp). Помилка → без фото.
    function photoDataUrl(url: string): Promise<string | null> {
      return new Promise((resolve) => {
        const img = new Image();
        img.onload = () => {
          try {
            const c = document.createElement("canvas");
            c.width = img.naturalWidth; c.height = img.naturalHeight;
            c.getContext("2d")!.drawImage(img, 0, 0);
            resolve(c.toDataURL("image/jpeg", 0.85));
          } catch { resolve(null); }
        };
        img.onerror = () => resolve(null);
        img.src = url;
      });
    }

    genBtn?.addEventListener("click", async () => {
      const area = (areaInput && parseArea(areaInput.value)) ?? data.areaDefault;
      const qty = qtyInput ? parseQty(qtyInput.value) : 1;
      if (area == null) return;
      genBtn.disabled = true;
      try {
        const [pmMod, vfsMod] = await Promise.all([
          import("pdfmake/build/pdfmake"),
          import("pdfmake/build/vfs_fonts"),
        ]);
        const pdfMake: any = (pmMod as any).default ?? pmMod;
        // vfs_fonts: розгортаємо CJS/ESM-обгортки до словника {*.ttf} і реєструємо.
        let vfs: any = (vfsMod as any).default ?? vfsMod;
        if (vfs && !vfs["Roboto-Regular.ttf"] && vfs.default) vfs = vfs.default;
        if (typeof pdfMake.addVirtualFileSystem === "function") pdfMake.addVirtualFileSystem(vfs);
        else pdfMake.vfs = vfs;

        const photo = data.photo ? await photoDataUrl(data.photo) : null;
        const sum = data.pricePerM2 != null ? total(area, qty, data.pricePerM2) : null;
        const now = new Date();
        const pad = (n: number) => String(n).padStart(2, "0");
        const dateStr = now.toLocaleDateString("uk-UA");
        const kpNo = `КП № ${now.getFullYear()}-${pad(now.getMonth() + 1)}${pad(now.getDate())}`;
        const INK = "#131a24", BRASS = "#9a7d44", MUTED = "#5c6066", LINE = "#d9d4c8";

        const details: [string, string][] = [
          ["Тип", data.type],
          ["Лінія", data.line],
          ...(data.finish ? [["Фініш", data.finish] as [string, string]] : []),
          ...(data.format ? [["Формат", data.format] as [string, string]] : []),
          ...(data.thickness ? [["Товщина", data.thickness] as [string, string]] : []),
        ];
        const priceCell = (txt: string) => ({ text: txt, alignment: "right", border: [false, false, false, true], borderColor: ["", "", "", LINE] });
        const labelCell = (txt: string) => ({ text: txt, color: MUTED, border: [false, false, false, true], borderColor: ["", "", "", LINE] });

        const docDefinition: any = {
          pageSize: "A4",
          pageMargins: [48, 52, 48, 56],
          defaultStyle: { font: "Roboto", fontSize: 10, color: INK, lineHeight: 1.25 },
          content: [
            {
              columns: [
                { stack: [
                  { text: "ALTACO", fontSize: 22, bold: true },
                  { text: data.business.overline, fontSize: 7, color: BRASS, characterSpacing: 2, margin: [0, 3, 0, 0] },
                ] },
                { stack: [
                  { text: kpNo, alignment: "right", color: MUTED },
                  { text: `Дата: ${dateStr}`, alignment: "right", color: MUTED, margin: [0, 2, 0, 0] },
                  { text: "Дійсна 14 днів", alignment: "right", color: MUTED, margin: [0, 2, 0, 0] },
                ] },
              ],
            },
            { text: "Комерційна пропозиція", fontSize: 18, bold: true, margin: [0, 20, 0, 14] },
            {
              columns: [
                photo
                  ? { image: photo, fit: [150, 110], width: 150 }
                  : { text: "", width: 150 },
                {
                  width: "*",
                  margin: [16, 0, 0, 0],
                  stack: [
                    { text: data.name, fontSize: 15, bold: true, margin: [0, 0, 0, 6] },
                    {
                      table: { widths: ["auto", "*"], body: details.map(([k, v]) => [
                        { text: k, color: MUTED },
                        { text: v },
                      ]) },
                      layout: "noBorders",
                    },
                  ],
                },
              ],
              margin: [0, 0, 0, 16],
            },
            {
              table: { widths: ["*", "auto"], body: [
                [labelCell("Площа сляба"), priceCell(`${num2(area)} м²`)],
                [labelCell("Кількість"), priceCell(`${qty} шт`)],
                [labelCell("Ціна за м²"), priceCell(data.pricePerM2 != null ? `${eur(data.pricePerM2)} / м²` : "за запитом")],
                [
                  { text: "Разом", bold: true, fontSize: 12, border: [false, false, false, false] },
                  { text: sum != null ? eur(sum) : "за запитом", alignment: "right", bold: true, fontSize: 14, color: BRASS, border: [false, false, false, false] },
                ],
              ] },
              layout: "noBorders",
            },
            { text: data.business.priceNote, fontSize: 8, color: MUTED, margin: [0, 8, 0, 18] },
            { text: "Умови", bold: true, margin: [0, 0, 0, 5] },
            { ul: [
              "Термін дії пропозиції — 14 днів від дати формування",
              "Фінальний розрахунок уточнюється після обміру по місцю",
            ], color: MUTED, fontSize: 9, margin: [0, 0, 0, 22] },
            { canvas: [{ type: "line", x1: 0, y1: 0, x2: 499, y2: 0, lineWidth: 0.5, lineColor: LINE }], margin: [0, 0, 0, 10] },
            { text: data.business.director, bold: true },
            { text: data.business.legal, color: MUTED, fontSize: 9, margin: [0, 3, 0, 0] },
            { text: `${data.business.phone} · ${data.business.email} · ${data.business.site}`, color: MUTED, fontSize: 9, margin: [0, 2, 0, 0] },
          ],
        };

        // Завантаження cross-browser: не покладаємось на внутрішній pdfmake .download()
        // (Chrome ріже його шлях saveAs). У pdfmake 0.3.x getBlob() — async і ПОВЕРТАЄ
        // Promise<Blob> (колбек ігнорується), тож await-имо blob і клікаємо власний
        // <a download> з object URL. Без window.open.
        const blob: Blob = await pdfMake.createPdf(docDefinition).getBlob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `KP-${data.id}.pdf`;
        a.style.display = "none";
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 4000);
        dialog!.close();
      } finally {
        genBtn.disabled = false;
      }
    });
  }
</script>
